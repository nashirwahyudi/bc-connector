# HTTP port (default 3000 — dipakai NPM: Forward Host be-connector, Port 3000)
PORT=3000

# RPC endpoint — get a free key at infura.io or alchemy.com
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Server wallet private key (fund with free Sepolia ETH from a faucet,
# e.g. sepoliafaucet.com or Alchemy's faucet). NEVER commit the real .env.
PRIVATE_KEY=0xabc123...

# Address printed after you deploy AuditAnchor.sol
CONTRACT_ADDRESS=0x...
